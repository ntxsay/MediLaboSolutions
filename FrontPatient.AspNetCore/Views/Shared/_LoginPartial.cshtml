@inject IHttpContextAccessor HttpContextAccessor

<ul class="navbar-nav">
@if (HttpContextAccessor.HttpContext is { User.Identity.IsAuthenticated: true })
{
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-controller="Login" asp-action="Logout">
            <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Se déconnecter</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" id="login" asp-controller="Login" asp-action="Login">Se connecter</a>
    </li>
}
</ul>
