@model FrontPatient.AspNetCore.Models.ViewModels.PatientViewModel

@{
    ViewData["Title"] = "Update";
}

<section>
    <h2>Editer le patient n° @Model.Id</h2>
    <form asp-action="Update" method="post"  enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="GenreId" class="control-label"></label>
            <select asp-for="GenreId" class ="form-control" asp-items="Model.Genres"></select>
        </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control"/>
            </div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control"/>
            </div>
            <div class="form-group">
                <label asp-for="BirthDate" class="control-label"></label>
                <input asp-for="BirthDate" class="form-control"/>
            </div>
            <div class="form-group">
                <label asp-for="NoTelephone" class="control-label"></label>
                <input asp-for="NoTelephone" class="form-control"/>
            </div>
            <div class="form-group">
                <label asp-for="PostalAddress" class="control-label"></label>
                <textarea asp-for="PostalAddress" class="form-control"></textarea>
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div >
                <input type="submit" value="Mettre à jour"  />
            </div>
        </form>
</section>